{
	"name": "@blackswampai/n8n-nodes-lago",
	"version": "0.1.3",
	"packageManager": "npm@11.19.0",
	"description": "n8n community node for Lago: subscription billing, usage metering, invoicing, prepaid credits, and billing lifecycle events",
	"license": "MIT",
	"homepage": "https://blackswampai.com/n8n-nodes/lago/",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"lago",
		"billing",
		"usage-based-billing",
		"metering",
		"subscriptions",
		"invoicing"
	],
	"author": {
		"name": "Christopher J. Nelson",
		"email": "christopherjnelson@proton.me"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/BlackSwampAI/n8n-nodes-lago.git"
	},
	"bugs": {
		"url": "https://github.com/BlackSwampAI/n8n-nodes-lago/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run",
		"test:unit": "vitest run test/unit",
		"test:integration": "vitest run test/integration",
		"test:watch": "vitest",
		"lago:up": "node scripts/lago-dev.mjs up",
		"lago:down": "node scripts/lago-dev.mjs down",
		"generate:webhook-events": "node scripts/generate-webhook-events.mjs",
		"release:check": "node scripts/release-check.mjs",
		"scan:source": "node scripts/scan-source.mjs",
		"scan:published": "node scripts/scan-published.mjs",
		"package:check": "node scripts/package-check.mjs",
		"smoke:load": "node scripts/node-load-smoke.mjs",
		"smoke:install": "node scripts/package-install-smoke.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/LagoApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Lago/Lago.node.js",
			"dist/nodes/Lago/LagoTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.46.4",
		"@n8n/scan-community-package": "0.34.0",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=22.22.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"allowScripts": {
		"eslint-plugin-n8n-nodes-base": false
	}
}
